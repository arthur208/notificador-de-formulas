# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Firebird (ERP SmartPharmacy) — somente leitura ---
FB_HOST=
FB_PORT=3050
FB_DB_PATH=
FB_USER=
FB_PASS=
FB_TIMEOUT_MS=15000

# --- MongoDB ---
# Em desenvolvimento, aponte MONGO_DB_NAME para um banco de DEV.
# Em produção, para o banco real. O código não muda.
#
# ATENÇÃO: o driver IGNORA o nome do banco no caminho da URI.
# Quem manda é MONGO_DB_NAME. O arranque imprime o destino — confira.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=notificadordev
MONGO_COLLECTION_LOGS=notificador_logs

# --- Servidor ---
PORT=3008

# --- Cifragem das credenciais do canal ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave torna as credenciais salvas ilegíveis — semeie de novo.
APP_CRYPTO_KEY=

# --- API de envio (MultiAtend) ---
# As credenciais NÃO ficam aqui: vivem no Mongo, semeadas por
# scripts/semear-canal.js
MULTIATEND_BASE_URL=https://api2.multiatendweb.com.br

# --- Webhook de envio (LEGADO) ---
# Ainda usado por controllers/messageController.js.
# Sai de cena na Parte 4, quando o envio migra para a API v1 do whatsmeow.
API_URL=
