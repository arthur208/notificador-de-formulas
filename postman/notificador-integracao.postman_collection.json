    {
      "name": "2. Atualização",
      "description": "Grava no ERP. Valida tudo antes de gravar qualquer coisa; falhando um campo, nada é alterado.",
      "item": [
        {
          "name": "Preencher endereço",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('respondeu 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().cliente;",
                  "pm.test('confirmou a gravação', () => pm.expect(pm.response.json().atualizado).to.be.true);",
                  "pm.test('o acento sobreviveu ao ERP', () => {",
                  "    pm.expect(c.cidade || '').to.not.include('Ã');",
                  "});",
                  "pm.test('faltando já reflete a gravação', () => {",
                  "    pm.expect(c.faltando).to.not.include('bairro');",
                  "    pm.expect(c.faltando).to.not.include('cep');",
                  "});",
                  "pm.test('o PUT também não devolve dado cru', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('logradouro');",
                  "});"
                ]
              },
              "name": "Preencher endereço"
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
